# Copie este arquivo para .env e ajuste os valores. O .env NÃO vai para o Git.
PORT=3000

# Chave usada para assinar a sessão. Troque por um texto longo e aleatório.
SESSION_SECRET=troque-esta-chave

# Banco SQLite e pasta das fotos (relativos à raiz do projeto)
DB_PATH=data/campuslost.db
UPLOAD_DIR=uploads

# Domínio de e-mail aceito no cadastro (RF01.2). Deixe vazio para aceitar qualquer um em desenvolvimento.
EMAIL_DOMINIO=
