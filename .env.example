# Copie este arquivo para .env e ajuste os valores. O .env NÃO vai para o Git.
PORT=3000

# Chave usada para assinar a sessão. Troque por um texto longo e aleatório.
SESSION_SECRET=troque-esta-chave

# Banco SQLite e pasta das fotos (relativos à raiz do projeto)
DB_PATH=data/campuslost.db
UPLOAD_DIR=uploads
# Pasta privada das provas de posse (não fica acessível pelo navegador)
PROVAS_DIR=provas

# Endereço do site, usado no link do e-mail de recuperação de senha
URL_BASE=http://localhost:3000

# E-mail para a recuperação de senha (RF01.6). Deixe SMTP_HOST vazio em desenvolvimento:
# o link aparece no terminal do servidor em vez de ser enviado.
# Exemplo com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 e uma "senha de app" em SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=CampusLost <nao-responda@campuslost.local>

# Domínio de e-mail aceito no cadastro (RF01.2). Deixe vazio para aceitar qualquer um em desenvolvimento.
EMAIL_DOMINIO=
